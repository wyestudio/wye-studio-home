# Supabase (표준 변수명 — 운영/테스트는 Vercel 프로젝트별 값으로만 구분,
# 코드에는 분기 없음. 로컬 .env.local에는 운영 또는 테스트 Supabase 프로젝트
# 값 중 하나를 넣어서 개발)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 URL — 도메인별로 다름 (운영: https://wouldyouescape.com,
# 테스트: https://test.wouldyouescape.com). 어드민 대시보드의 "링크 복사"
# 버튼 등에서 사용. layout.tsx의 OG/JSON-LD 메타데이터에도 반영
NEXT_PUBLIC_SITE_URL=https://wouldyouescape.com

# 테스트 환경 표시 — 테스트 Vercel 프로젝트에서만 "true"로 설정.
# SMS 발송 스킵 + Slack 알림 [테스트] prefix + 배너 표시에 사용.
# 운영 프로젝트는 비워두거나 "false"로 설정하면 됨
NEXT_PUBLIC_IS_TEST_ENV=false

# 사이트 전체 비밀번호 게이트 — 테스트 Vercel 프로젝트에만 설정
# (운영 프로젝트는 비워두면 게이트 자체가 꺼짐)
SITE_ACCESS_PASSWORD=

# 사이트 게이트 경로 (선택, 기본값: /site-gate-w3k9m5x7)
# SITE_GATE_PATH=/site-gate-w3k9m5x7

# Slack 알림
SLACK_WEBHOOK_URL=
# 결제 확정 후 취소(환불) 알림 전용 — #refund-notification 채널 Incoming Webhook URL
SLACK_REFUND_WEBHOOK_URL=

# SMS 발송 (Solapi)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# 분석 및 마케팅
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ABOUT_ENABLED=

# 어드민 페이지 (운영/테스트 공용)
ADMIN_PATH=/admin-x7f9k2m3
ADMIN_PASSWORD=
CRON_SECRET=

# GA4 분석 대시보드 (개인 Google Cloud 프로젝트의 서비스 계정)
# 1. GA4_PROPERTY_ID: analytics.google.com → 관리 → 우주이스케이프 속성 → 속성 설정에서 복사한 숫자 ID
GA4_PROPERTY_ID=
# 2. GOOGLE_SERVICE_ACCOUNT_EMAIL: JSON 파일의 "client_email" 값
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 3. GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: JSON 파일의 "private_key" 값 (-----BEGIN부터 -----END까지 전체, 개행 포함)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
